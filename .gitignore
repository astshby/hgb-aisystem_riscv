# 根目录采用白名单：未明确列出的顶层文件和目录默认不进入版本库。
/*
!/third_party/
/third_party/*
!/third_party/yolo_npu128/
!/.gitignore
!/.gitattributes
!/.gitmodules
!/.github/
!/AGENTS.md
!/LICENSE
!/Makefile
!/README.md
!/benchmark/
!/software/
!/constr/
!/docs/
!/ip/
!/scripts/
!/tb/
!/vsrc/

# Python bytecode
__pycache__/
*.pyc
/.venv/
/software/yolo/.cache/
/software/minimind3/.cache/

# MiniMind: preserve sources/configuration/manifests, ignore generated large files.
/software/minimind3/model/*.safetensors
/software/minimind3/model/*.bin
/software/minimind3/model/.cache/
/software/minimind3/.cache/
/software/minimind3/.venv*/
/software/minimind3/c_runtime/assets/*.bin
!/software/minimind3/c_runtime/assets/model_w8a16_int.bin
!/software/minimind3/c_runtime/assets/tokenizer.bin
/software/minimind3/c_runtime/assets/*.hex
/software/minimind3/c_runtime/build/
/software/minimind3/c_runtime/minimind3.elf
