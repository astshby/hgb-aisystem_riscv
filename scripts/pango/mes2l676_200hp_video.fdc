# MES2L676-200HP HDMI transmitter pins from the same-board hdmi_dyn_ppll reference.
# Reference: 2_Demo/4_6_hdmi_dyn_ppll/4_6_hdmi_dyn_ppll/hdmi_dyn_ppll.fdc.
# XRGB8888 scanout drives hdmi_rgb[23:16]=R, [15:8]=G, [7:0]=B.
# No input/output delay or CDC exception is invented here; board I/O timing remains to be measured.
create_clock -name {video_ref_clk} [get_ports {video_ref_clk}] -period {37.037037037} -waveform {0.000000000 18.518518519}
create_generated_clock -name {clk_video} -source [get_ports {video_ref_clk}] [get_pins {g_video_clock.u_video_pll.u_pll/CLKOUT0}] -master_clock [get_clocks {video_ref_clk}] -multiply_by {11} -divide_by {2}
create_generated_clock -name {hdmi_pixel_clk} -source [get_pins {g_video_clock.u_video_pll.u_pll/CLKOUT0}] [get_ports {hdmi_pixel_clk}] -master_clock [get_clocks {clk_video}] -multiply_by {1} -divide_by {1}
define_attribute {p:video_ref_clk} {PAP_IO_DIRECTION} {INPUT}
define_attribute {p:video_ref_clk} {PAP_IO_LOC} {D18}
define_attribute {p:video_ref_clk} {PAP_IO_VCCIO} {3.3}
define_attribute {p:video_ref_clk} {PAP_IO_STANDARD} {LVCMOS33}
define_attribute {p:video_ref_clk} {PAP_IO_NONE} {TRUE}
define_attribute {p:hdmi_pixel_clk} {PAP_IO_DIRECTION} {OUTPUT}
define_attribute {p:hdmi_pixel_clk} {PAP_IO_LOC} {T24}
define_attribute {p:hdmi_pixel_clk} {PAP_IO_VCCIO} {3.3}
define_attribute {p:hdmi_pixel_clk} {PAP_IO_STANDARD} {LVCMOS33}
define_attribute {p:hdmi_pixel_clk} {PAP_IO_DRIVE} {8}
define_attribute {p:hdmi_pixel_clk} {PAP_IO_NONE} {TRUE}
define_attribute {p:hdmi_pixel_clk} {PAP_IO_SLEW} {FAST}
